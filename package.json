{
  "name": "opencode",
  "version": "1.0.0",
  "description": "3D Snake — a 3D snake game for the browser (Three.js with a 2D fallback): eat orbs, climb a shrinking-window combo ladder, bank streaks, conquer 8 arena biomes and a daily challenge. Playable offline as a PWA.",
  "main": "main.js",
  "scripts": {
    "test": "node e2e/test.js",
    "test:unit": "node test/unit.js",
    "test:scan": "node test/scan.js",
    "test:contrast": "node test/contrast.js",
    "test:mobile": "node e2e/mobile.js",
    "test:perf": "node e2e/perf.js",
    "test:edge": "node e2e/edge.js",
    "test:resolutions": "node e2e/resolutions.js",
    "test:live": "node e2e/live.js",
    "test:sw-version": "node test/sw-version.js",
    "test:all": "npm run test:unit && npm run test:scan && npm run test:contrast && npm run test:sw-version && npm test && npm run test:mobile && npm run test:edge && npm run test:resolutions && npm run test:perf",
    "serve": "node serve.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "game",
    "snake",
    "3d",
    "threejs",
    "webgl",
    "browser",
    "pwa",
    "offline",
    "daily-challenge"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LightningJake/serpentia.git"
  },
  "homepage": "https://serpentia-coral.vercel.app/",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
